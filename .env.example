# Ciento Swap — environment configuration
# Copy to .env.local for local development

# --- Public (sent to browser) ---

# WalletConnect Cloud project ID
NEXT_PUBLIC_WC_PROJECT_ID=

# Base RPC endpoints
NEXT_PUBLIC_BASE_RPC=https://mainnet.base.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC=https://sepolia.base.org

# API base URL (for Jin's frontend quote client)
# When set, frontend hits real backend; when empty, uses mock
NEXT_PUBLIC_API_BASE=

# Contract addresses (Base mainnet defaults)
NEXT_PUBLIC_UNISWAP_V3_ROUTER=0x2626664c2603336E57B271c5C0b26F421741e481
NEXT_PUBLIC_UNISWAP_V3_QUOTER=0xb27308f9F90D607463bb33eA1BeBb41C27CE5AB6
NEXT_PUBLIC_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
NEXT_PUBLIC_USDT_ADDRESS=0xfde4C96c8593536E31F229EA8f37b2ADa2699bb2

# --- Server-only (NEVER expose to frontend) ---

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Base RPC (server-side, can use premium endpoint)
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY

# Platform fee (bips: 30 = 0.3%)
PLATFORM_FEE_BIPS=30
