# Ciento Swap — environment configuration
# Copy to .env.local for local development

# --- Public (sent to browser) ---

# WalletConnect Cloud project ID
# Get one at https://cloud.walletconnect.com — free
NEXT_PUBLIC_WC_PROJECT_ID=

# Custom RPC endpoints (optional — defaults are public Base RPCs)
NEXT_PUBLIC_BASE_RPC=https://mainnet.base.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC=https://sepolia.base.org

# Quote / swap API base URL — Neo's backend
# Leave empty in scaffold phase to use the in-app mock quote
NEXT_PUBLIC_API_BASE=

# --- Server-only (do NOT prefix with NEXT_PUBLIC_) ---

# Reserved for future server secrets (KMS, signing, etc.)